{
  "title": "Banking API Dashboard",
  "tags": ["banking", "api", "monitoring"],
  "timezone": "browser",
  "panels": [
    {
      "title": "HTTP Requests",
      "type": "graph",
      "targets": [{
        "expr": "rate(http_requests_total[5m])",
        "legendFormat": "{{method}} {{endpoint}}"
      }]
    },
    {
      "title": "Withdrawal Volume",
      "type": "stat",
      "targets": [{
        "expr": "sum(withdrawal_amount)"
      }]
    }
  ]
}